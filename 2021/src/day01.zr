// Advent of Code 2021, day 1: Sonar Sweep
import std.fs;

fn part1(input: &str) i32 {
    var tmp = i32.MAX;
    var cnt = 0;

    for line in input.lines().map(fn(line) line.parse_int().unwrap()) {
        if line as i32 > tmp {
            cnt += 1;
        }
        tmp = line as i32;
    }

    return cnt;
}

fn part2(input: &str) i32 {
    var tmp = i32.MAX;
    var cnt = 0;

    for window_sum in input.lines().map(fn(line) line.parse_int().unwrap()).windows(3) {
        const SUM = window_sum.sum();
        if SUM as i32 > tmp {
            cnt += 1;
        }
        tmp = SUM as i32;
    }

    return cnt;
}

fn main() {
    const INPUT: str = fs::embed_file("../input/day01.txt");
    println("{}", part1(&INPUT));
    println("{}", part2(&INPUT));
}
