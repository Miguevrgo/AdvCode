import std.fs;

fn part1(input: str) i32 {
    var tmp = i32.MAX;
    var cnt = 0;

    for line in input.lines().map(fn(line) line.parse().unwrap()) {
        if line > tmp {
            cnt += 1;
        }
        tmp = line;
    }

    return cnt;
}

fn part2(input: str) i32 {
    var tmp = i32.MAX;
    var cnt = 0;

    for window_sum in input.lines().map(fn(line) line.parse().unwrap()).windows(3) {
        const SUM = window_sum.sum();
        if SUM > tmp {
            cnt += 1;
        }
        tmp = SUM;
    }

    return cnt;
}

pub fn run() String {
    const INPUT: str = fs::embed_file("../input/day01.txt");
    return format("{} {}", part1(INPUT), part2(INPUT));
}
